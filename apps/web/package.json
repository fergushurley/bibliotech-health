{
  "name": "@bibliotech/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "dev:vinext": "BIBLIOTECH_CLOUDFLARE=1 vite dev --port 3001",
    "build:vinext": "BIBLIOTECH_CLOUDFLARE=1 vite build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "wrangler deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "lucide-react": "^0.468.0",
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "vinext": "1.0.0-beta.13",
    "react-server-dom-webpack": "19.3.0",
    "@vinext/cloudflare": "1.0.0-beta.11"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "vite": "8.3.1",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "@cloudflare/vite-plugin": "1.61.0",
    "wrangler": "4.142.0"
  }
}
