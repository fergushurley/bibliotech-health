{
  "name": "bibliotech-health-alternative",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3101",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3101",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && npm run typecheck:cloudflare",
    "test:e2e": "playwright test",
    "build:cloudflare": "BIBLIOTECH_CLOUDFLARE=1 vite build",
    "deploy:cloudflare": "wrangler deploy --config dist/server/wrangler.json",
    "preview:cloudflare": "wrangler dev --config dist/server/wrangler.json",
    "typecheck:cloudflare": "tsc --noEmit -p cloudflare/tsconfig.json"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "lucide-react": "^0.468.0",
    "@modelcontextprotocol/client": "2.1.0",
    "zod": "^4.0.0",
    "vinext": "1.0.0-beta.13",
    "react-server-dom-webpack": "19.3.0",
    "@vinext/cloudflare": "1.0.0-beta.11"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vitest": "5.0.2",
    "@playwright/test": "^1.55.0",
    "vite": "8.3.1",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "@cloudflare/vite-plugin": "1.61.0",
    "wrangler": "4.142.0",
    "@cloudflare/workers-types": "5.20260927.1"
  }
}
