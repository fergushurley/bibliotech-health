# Server-only. In GBrain, create a client for a synthetic-only workspace.
# Add its Memory application with Full permission, then Add a connection.
GBRAIN_TOKEN=
GBRAIN_MCP_URL=https://gbrain.io/mcp
# Isolates this alternative prototype from other demos using the same workspace.
GBRAIN_ENTITY=projects/bibliotech-alternative/demo-jordan-taylor
# Optional real workspace URL for the Open in GBrain action.
GBRAIN_WORKSPACE_URL=
