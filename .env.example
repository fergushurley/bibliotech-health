# Choose local (installed GBrain over MCP stdio) or hosted (Streamable HTTP).
GBRAIN_MODE=local
# Absolute path; GBrain and its Bun runtime must already be installed.
GBRAIN_BIN=/absolute/path/to/gbrain
# Hosted only: dedicated GBrain connection with Full Memory permission.
# The bearer token belongs only in the root .env.local, never NEXT_PUBLIC_*.
GBRAIN_TOKEN=
